# Multi-stage Dockerfile for Ministral-8B deployment using official TT-Metalium image
# Based on official Tenstorrent documentation: https://docs.tenstorrent.com/tt-metal/latest/ttnn/ttnn/installing.html

# Stage 1: Use official TT-Metalium Docker image as base
FROM ghcr.io/tenstorrent/tt-metal/tt-metalium-ubuntu-22.04-release-amd64:latest-rc AS ttnn-base

# Add HF_TOKEN argument and environment variable for Hugging Face authentication
ARG HF_TOKEN
ENV HF_TOKEN=$HF_TOKEN

# Set working directory
WORKDIR /workspace

# Set non-interactive mode for apt
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY models/demos/wormhole/ministral8b/requirements-docker.txt /workspace/requirements-docker.txt
COPY models/demos/wormhole/ministral8b/requirements.txt /workspace/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt -r requirements-docker.txt && \
    pip install --no-cache-dir --upgrade pydantic && \
    pip install --no-cache-dir git+https://github.com/tenstorrent/llama-models.git@tt_metal_tag

# Stage 2: Application setup
FROM ttnn-base AS app

# Copy the entire tt-metal repository to preserve the expected directory structure
COPY . /workspace/

# Set working directory to the tt-metal root
WORKDIR /workspace

# Create necessary directories with proper permissions
RUN mkdir -p /workspace/model_cache /workspace/huggingface && \
    chmod -R 777 /workspace/model_cache /workspace/huggingface

# Set permissions for the server and download scripts
RUN chmod +x /workspace/models/demos/wormhole/ministral8b/server.py && \
    chmod +x /workspace/models/demos/wormhole/ministral8b/download_model.py

# Set up environment variables
ENV TT_METAL_HOME=/workspace
ENV PYTHONPATH=/workspace:/workspace/models
ENV ARCH_NAME=wormhole_b0
ENV ENVIRONMENT=production
ENV IS_DOCKER_ENVIRONMENT=true
ENV MODEL_CACHE_PATH=/workspace/model_cache
ENV HF_HOME=/workspace/huggingface
ENV LDFLAGS="-L/workspace/runtime/hw/lib/wormhole -lerisc"

# Health check - just check if the server is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Create and set permissions for firmware script
RUN mkdir -p /scripts
COPY <<'EOF' /scripts/generate_firmware_scripts.sh
#!/bin/bash

# Create the necessary directories
mkdir -p /workspace/runtime/hw/toolchain/wormhole

# Create the firmware_brisc.ld file
cat > /workspace/runtime/hw/toolchain/wormhole/firmware_brisc.ld << 'EOL'
/* Linker script for BRISC firmware */
OUTPUT_ARCH(riscv)
ENTRY(_start)

MEMORY {
    BRISC_L1 (rwx) : ORIGIN = 0xFFB20000, LENGTH = 0x10000
}

SECTIONS {
    .text : {
        *(.text*)
    } > BRISC_L1

    .data : {
        *(.data*)
        *(.rodata*)
        *(.sdata*)
    } > BRISC_L1

    .bss : {
        *(.bss*)
        *(COMMON)
    } > BRISC_L1

    /DISCARD/ : {
        *(.comment)
        *(.note*)
    }
}
EOL

# Create firmware_trisc0.ld
cat > /workspace/runtime/hw/toolchain/wormhole/firmware_trisc0.ld << 'EOL'
/* Linker script for TRISC0 firmware */
OUTPUT_ARCH(riscv)
ENTRY(_start)

MEMORY {
    TRISC0_L1 (rwx) : ORIGIN = 0xFFB00000, LENGTH = 0x10000
}

SECTIONS {
    .text : {
        *(.text*)
    } > TRISC0_L1

    .data : {
        *(.data*)
        *(.rodata*)
        *(.sdata*)
    } > TRISC0_L1

    .bss : {
        *(.bss*)
        *(COMMON)
    } > TRISC0_L1
}
EOL

# Create firmware_trisc1.ld
cat > /workspace/runtime/hw/toolchain/wormhole/firmware_trisc1.ld << 'EOL'
/* Linker script for TRISC1 firmware */
OUTPUT_ARCH(riscv)
ENTRY(_start)

MEMORY {
    TRISC1_L1 (rwx) : ORIGIN = 0xFFB10000, LENGTH = 0x10000
}

SECTIONS {
    .text : {
        *(.text*)
    } > TRISC1_L1

    .data : {
        *(.data*)
        *(.rodata*)
        *(.sdata*)
    } > TRISC1_L1

    .bss : {
        *(.bss*)
        *(COMMON)
    } > TRISC1_L1
}
EOL

# Create firmware_trisc2.ld
cat > /workspace/runtime/hw/toolchain/wormhole/firmware_trisc2.ld << 'EOL'
/* Linker script for TRISC2 firmware */
OUTPUT_ARCH(riscv)
ENTRY(_start)

MEMORY {
    TRISC2_L1 (rwx) : ORIGIN = 0xFFB30000, LENGTH = 0x10000
}

SECTIONS {
    .text : {
        *(.text*)
    } > TRISC2_L1

    .data : {
        *(.data*)
        *(.rodata*)
        *(.sdata*)
    } > TRISC2_L1

    .bss : {
        *(.bss*)
        *(COMMON)
    } > TRISC2_L1
}
EOL

# Create firmware_ncrisc.ld
cat > /workspace/runtime/hw/toolchain/wormhole/firmware_ncrisc.ld << 'EOL'
/* Linker script for NCRISC firmware */
OUTPUT_ARCH(riscv)
ENTRY(_start)

MEMORY {
    NCRISC_L1 (rwx) : ORIGIN = 0xFFBF0000, LENGTH = 0x10000
}

SECTIONS {
    .text : {
        *(.text*)
    } > NCRISC_L1

    .data : {
        *(.data*)
        *(.rodata*)
        *(.sdata*)
    } > NCRISC_L1

    .bss : {
        *(.bss*)
        *(COMMON)
    } > NCRISC_L1
}
EOL

# Create firmware_erisc.ld
cat > /workspace/runtime/hw/toolchain/wormhole/firmware_erisc.ld << 'EOL'
/* Linker script for ERISC firmware */
OUTPUT_ARCH("riscv")
OUTPUT_FORMAT("elf32-littleriscv")
GROUP(-lc)
ENTRY(_start)

MEMORY
{
  UCODE     (rwx): ORIGIN = 0x00008000, LENGTH = 0x00008000
  RAM       (rwx): ORIGIN = 0x00100000, LENGTH = 0x00080000
  L1        (rwx): ORIGIN = 0x00180000, LENGTH = 0x00080000
}

SECTIONS
{
  .text :
  {
    KEEP(*(.text.start))
    *(.text)
    *(.text.*)
  } > RAM

  .rodata :
  {
    *(.rodata)
    *(.rodata.*)
  } > RAM

  .data :
  {
    *(.data)
    *(.data.*)
    *(.sdata)
    *(.sdata.*)
  } > RAM

  .bss :
  {
    *(.bss)
    *(.bss.*)
    *(.sbss)
    *(.sbss.*)
  } > RAM
}
EOL

# Create erisc-b0-app.ld
cat > /workspace/runtime/hw/toolchain/wormhole/erisc-b0-app.ld << 'EOL'
/* Linker script for ERISC B0 application */
OUTPUT_ARCH("riscv")
OUTPUT_FORMAT("elf32-littleriscv")
GROUP(-lc)
ENTRY(_start)

MEMORY
{
  UCODE     (rwx): ORIGIN = 0x00008000, LENGTH = 0x00008000
  RAM       (rwx): ORIGIN = 0x00100000, LENGTH = 0x00080000
  L1        (rwx): ORIGIN = 0x00180000, LENGTH = 0x00080000
}

SECTIONS
{
  .text :
  {
    KEEP(*(.text.start))
    *(.text)
    *(.text.*)
  } > RAM

  .rodata :
  {
    *(.rodata)
    *(.rodata.*)
  } > RAM

  .data :
  {
    *(.data)
    *(.data.*)
    *(.sdata)
    *(.sdata.*)
  } > RAM

  .bss :
  {
    *(.bss)
    *(.bss.*)
    *(.sbss)
    *(.sbss.*)
  } > RAM
}
EOL

echo "Created firmware linker scripts in: /workspace/runtime/hw/toolchain/wormhole"
echo "Files created:"
ls -la /workspace/runtime/hw/toolchain/wormhole/
EOF

# Make the script executable and run it
RUN chmod +x /scripts/generate_firmware_scripts.sh && \
    /scripts/generate_firmware_scripts.sh

# Create the firmware lib directory and stub object files needed for linking
RUN mkdir -p /workspace/runtime/hw/lib/wormhole && \
    cd /workspace/runtime/hw/lib/wormhole && \
    touch tmu-crt0.o noc.o substitutes.o ncrisc-halt-wormhole.o tdma_xmov.o && \
    chmod 644 tmu-crt0.o noc.o substitutes.o ncrisc-halt-wormhole.o tdma_xmov.o && \
    cd /workspace/runtime/hw/toolchain && \
    touch erisc-crt0.o && chmod 644 erisc-crt0.o && \
    # Create a pre-compiled empty static library instead of compiling
    cd /workspace/runtime/hw/lib/wormhole && \
    # Create an empty archive
    touch empty_file && \
    ar rcs liberisc.a empty_file && \
    rm empty_file && \
    # Add necessary symbols to the library using 'ar' directly
    touch __erisc_jump_table && \
    touch l1_to_local_mem_copy && \
    touch kernel_init && \
    touch __ldm_bss_end && \
    touch __ldm_bss_start && \
    touch wzerorange && \
    ar rs liberisc.a __erisc_jump_table l1_to_local_mem_copy kernel_init __ldm_bss_end __ldm_bss_start wzerorange && \
    rm __erisc_jump_table l1_to_local_mem_copy kernel_init __ldm_bss_end __ldm_bss_start wzerorange && \
    echo "Created ERISC stub library using pre-compiled approach"

# Install requirements if the file exists
RUN if [ -f "requirements-docker.txt" ]; then \
        pip install --no-cache-dir -r requirements-docker.txt; \
    else \
        echo "requirements-docker.txt not found, skipping dependency installation"; \
    fi

# Set execute permissions for server files
RUN chmod +x /workspace/models/demos/wormhole/ministral8b/server.py && \
    [ -f "/workspace/models/demos/wormhole/ministral8b/test_server.py" ] && chmod +x /workspace/models/demos/wormhole/ministral8b/test_server.py || true

# Create a startup script that starts the server immediately in foreground and downloads in background
RUN echo '#!/bin/bash\n\n# Start the server immediately in foreground to bind port 8000\n# The server will handle background downloads internally via model_manager\nexec python /workspace/models/demos/wormhole/ministral8b/server.py --port 8000' > /startup.sh \
&& chmod +x /startup.sh

# Default command
CMD ["/startup.sh"]