FROM ghcr.io/tenstorrent/tt-metal/tt-metalium/ubuntu-24.04-basic-dev-amd64:7f995358bcf7a7948eb0da60ce3528eb1045d1c6

WORKDIR /workspace
COPY . .

RUN python3 -m pip install -r tt_metal/python_env/requirements-dev.txt
ENV PYTHONPATH=/workspace
ENV TT_METAL_HOME=/workspace
CMD ["python3", "models/tt_transformers/demo/simple_text_demo.py"]
