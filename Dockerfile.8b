FROM ghcr.io/tenstorrent/tt-metal/tt-metalium-ubuntu-22.04-release-amd64:latest

WORKDIR /workspace
COPY . .

RUN bash install_dependencies.sh --docker --no-distributed

# Install pinned SFPI x86_64 Debian package (ensure /opt/tenstorrent/sfpi exists)
ARG SFPI_VERSION=7.7.0-release
ARG SFPI_FILE=sfpi_${SFPI_VERSION}_x86_64_debian.deb
ARG SFPI_SHA256=cb6d7eaae1a8207cb2eb61c9add897090b4291dd8a961fe06df45569d0a8f1b0
RUN set -eux; \
	SFPI_URL="https://github.com/tenstorrent/sfpi/releases/download/${SFPI_VERSION}/${SFPI_FILE}"; \
	wget -O /tmp/${SFPI_FILE} "$SFPI_URL"; \
	echo "${SFPI_SHA256}  /tmp/${SFPI_FILE}" > /tmp/sfpi.sha256; \
	sha256sum -c /tmp/sfpi.sha256; \
	apt-get update -qq; \
	apt-get install -y --no-install-recommends /tmp/${SFPI_FILE}; \
	rm -f /tmp/${SFPI_FILE} /tmp/sfpi.sha256

# Verify SFPI installation - critical for runtime device initialization
RUN test -d /opt/tenstorrent/sfpi || \
	(echo 'ERROR: SFPI install failed - /opt/tenstorrent/sfpi missing' && exit 1)

# Create health check script for hardware detection
RUN echo '#!/bin/bash\n\
set -e\n\
echo "=== Tenstorrent Hardware Detection ==="\n\
if command -v tt-smi &> /dev/null; then\n\
    if tt-smi 2>&1 | grep -q "No devices"; then\n\
        echo "WARNING: No Tenstorrent devices detected"\n\
        echo "This container requires Tenstorrent hardware (Grayskull/Wormhole/Blackhole)"\n\
        echo "Running in NO-HARDWARE mode - tests will be skipped"\n\
        export TT_METAL_NO_HARDWARE=1\n\
        exit 0\n\
    else\n\
        echo "Tenstorrent devices found:"\n\
        tt-smi\n\
        tt-smi -r\n\
    fi\n\
else\n\
    echo "WARNING: tt-smi not found"\n\
fi\n\
' > /usr/local/bin/check-hardware.sh && chmod +x /usr/local/bin/check-hardware.sh

RUN python3 -m pip install -r tt_metal/python_env/requirements-dev.txt

ENV PYTHONPATH=/workspace
ENV TT_METAL_HOME=/workspace
ENV HF_MODEL=mistralai/Ministral-8B-Instruct-2410
ENV TT_METAL_SLOW_DISPATCH_MODE=1

# Entrypoint that checks for hardware before running tests
CMD ["sh", "-c", "check-hardware.sh && if [ -z \"$TT_METAL_NO_HARDWARE\" ]; then python3 -m pytest models/tt_transformers/demo/simple_text_demo.py::test_demo_text -k 'batch-1 and performance' --capture=no; else echo 'Skipping hardware tests - no Tenstorrent devices available'; echo 'To run this container, you need:'; echo '1. Tenstorrent AI accelerator hardware (Grayskull/Wormhole/Blackhole)'; echo '2. Proper device drivers installed on the host'; echo '3. Device access permissions configured'; python3 -c \"import ttnn; print(f'ttnn version: {ttnn.__version__}'); print('Container is ready but requires hardware to run tests')\"; fi"]