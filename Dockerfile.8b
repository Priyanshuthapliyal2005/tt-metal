FROM ghcr.io/tenstorrent/tt-metal/tt-metalium/ubuntu-24.04-dev-amd64:0b2ae09fc8a79c9f0d8cecc7a96ada6e37b09265

WORKDIR /workspace
COPY . .

RUN python3 -m pip install -r tt_metal/python_env/requirements-dev.txt
ENV PYTHONPATH=/workspace
ENV TT_METAL_HOME=/workspace
CMD ["python3", "models/tt_transformers/demo/simple_text_demo.py"]
